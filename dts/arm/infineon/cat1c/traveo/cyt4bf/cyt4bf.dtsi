                        reg = <0x40311100 0x80>;
			interrupt-parent = <&intmux_ch2>;
                        interrupts = <57 0>;
                        gpio-controller;
                        ngpios = <8>;
                        status = "disabled";
                        #gpio-cells = <2>;
                };

		scb0: scb@40600000 {
                        compatible = "infineon,scb";
                        reg = <0x40600000 0xfd0>;
			interrupt-parent = <&intmux_ch3>;
                        interrupts = <18 0>;
                        clk-dst = <0x11e>;
                        status = "disabled";
                };

                scb1: scb@40610000 {
                        compatible = "infineon,scb";
                        reg = <0x40610000 0xfd0>;
			interrupt-parent = <&intmux_ch3>;
                        interrupts = <113 0>;
                        clk-dst = <0x11f>;
                        status = "disabled";
                };

                scb2: scb@40620000 {
                        compatible = "infineon,scb";
                        reg = <0x40620000 0xfd0>;
			interrupt-parent = <&intmux_ch3>;
                        interrupts = <114 0>;
                        clk-dst = <0x120>;
                        status = "disabled";
                };

                scb3: scb@40630000 {
                        compatible = "infineon,scb";
                        reg = <0x40630000 0xfd0>;
			interrupt-parent = <&intmux_ch3>;
                        interrupts = <115 0>;
                        clk-dst = <0x121>;
                        status = "disabled";
                };

                scb4: scb@40640000 {
