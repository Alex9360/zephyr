#include <arm/infineon/cat1c/traveo/cyt4bf/cyt4bfcche.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pinctrl/ifx_cat1-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {

	pwmleds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led_0 {
			pwms = <&pwm4_10 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

		pwm_led1: pwm_led_1 {
			pwms = <&pwm3_18 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	leds {
		compatible = "gpio-leds";

		cpu_user_led0: led0 {
			label = "LED_0";
			gpios = <&gpio_prt23 2 GPIO_ACTIVE_HIGH>;
		};

		cpu_user_led1: led1 {
			label = "LED_1";
			gpios = <&gpio_prt0 0 GPIO_ACTIVE_HIGH>;
		};

		bb_user_led0: led2 {
			label = "LED_2";
			gpios = <&gpio_prt32 3 GPIO_ACTIVE_HIGH>;
		};

		bb_user_led1: led3 {
			label = "LED_3";
			gpios = <&gpio_prt32 5 GPIO_ACTIVE_HIGH>;
		};

		bb_user_led2: led4 {
			label = "LED_4";
			gpios = <&gpio_prt32 2 GPIO_ACTIVE_HIGH>;
		};

		bb_user_led3: led5 {
			label = "LED_5";
			gpios = <&gpio_prt31 2 GPIO_ACTIVE_HIGH>;
		};

		bb_user_led4: led6 {
			label = "LED_6";
			gpios = <&gpio_prt31 0 GPIO_ACTIVE_HIGH>;
		};

		bb_user_led5: led7 {
			label = "LED_7";
			gpios = <&gpio_prt29 7 GPIO_ACTIVE_HIGH>;
		};

		bb_user_led6: led8 {
			label = "LED_8";
			gpios = <&gpio_prt29 4 GPIO_ACTIVE_HIGH>;
		};

		bb_user_led7: led9 {
			label = "LED_9";
			gpios = <&gpio_prt3 7 GPIO_ACTIVE_HIGH>;
		};

		bb_user_led8: led10 {
			label = "LED_10";
			gpios = <&gpio_prt3 5 GPIO_ACTIVE_HIGH>;
		};

		bb_user_led9: led11 {
			label = "LED_11";
			gpios = <&gpio_prt2 7 GPIO_ACTIVE_HIGH>;
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;

		sram_m0plus: memory@28000800 {
			compatible = "mmio-sram";
			reg = <0x28000800 DT_SIZE_K(16)>;
		};

		sram_m7_0: memory@28004000 {
			compatible = "mmio-sram";
			reg = <0x28004000  DT_SIZE_K(816)>;
		};

		sram_m7_1: memory@280d0000 {
			compatible = "mmio-sram";
			reg = <0x280d0000 DT_SIZE_K(64)>;
		};
	};
};

&code_flash0 {
        partitions {
                ranges;
                #address-cells = <1>;
                #size-cells = <1>;

                m0p_partition: partition_m0p@0 {
                        compatible = "zephyr,mapped-partition";
                        label = "m0p_partition";
                        reg = <0x0 DT_SIZE_K(512)>;
                };

                m7_0_partition: partition@80000 {
                        compatible = "zephyr,mapped-partition";
                        label = "m7_0_partition";
                        reg = <0x80000 DT_SIZE_K(2048)>;
                };

                m7_1_partition: partition@280000 {
                        compatible = "zephyr,mapped-partition";
                        label = "m7_1_partition";
                        reg = <0x280000 DT_SIZE_K(5824)>;
                };
        };
};

i2c2: &scb2 {
        compatible = "infineon,i2c";
        #address-cells = <1>;
        #size-cells = <0>;
        clocks = <&clk_peri1 32 0 2>;
        /* I2C pins */
	pinctrl-0 = <&p14_2_scb2_i2c_scl &p14_1_scb2_i2c_sda>;
	pinctrl-names = "default";
        status = "okay";
};

uart3: &scb3 {
        compatible = "infineon,uart";
        current-speed = <115200>;
        clocks = <&clk_peri1 33 0 1>;

        /* UART pins */
	pinctrl-0 = <&p13_1_scb3_uart_tx &p13_0_scb3_uart_rx
			 &p13_2_scb3_uart_rts &p13_3_scb3_uart_cts>;
        pinctrl-names = "default";

	dmas = <&dma1 22>, <&dma1 23>;
	dma-names = "tx", "rx";
};

uart4: &scb4 {
        compatible = "infineon,uart";
        current-speed = <115200>;
        clocks = <&clk_peri1 34 0 2>;

        /* UART pins */
	pinctrl-0 = <&p10_1_scb4_uart_tx &p10_0_scb4_uart_rx
			 &p10_2_scb4_uart_rts &p10_3_scb4_uart_cts>;
        pinctrl-names = "default";

	dmas = <&dma1 24>, <&dma1 25>;
	dma-names = "tx", "rx";
};

spi5: &scb5 {
	#address-cells = <1>;
	#size-cells = <0>;
	compatible = "infineon,spi";
	clocks = <&clk_peri1 35 1 3>;

	/* SPI pins */
	pinctrl-0 = <&p4_0_scb5_spi_m_miso &p4_1_scb5_spi_m_mosi &p4_2_scb5_spi_m_clk>;
	pinctrl-names = "default";
	cs-gpios = <&gpio_prt4 3 GPIO_ACTIVE_LOW>;

	dmas = <&dma1 26>, <&dma1 27>;
	dma-names = "tx", "rx";
};

can0: &can0_1 {
        clocks = <&clk_peri1 1 1 0>;
        frequency = <40000000>;
        pinctrl-0 = <&p0_2_can0_1_tx &p0_3_can0_1_rx>;
        pinctrl-names = "default";
        status = "okay";
};

&canfd0 {
	status = "okay";
};

&dma1 {
	status = "okay";
};

&adc1 {
        #address-cells = <1>;
        #size-cells = <0>;
        clocks = <&clk_peri1 43 0 3>;
        clock-frequency = <26670000>;
        status = "okay";
};

&gpio_prt0 {
	status = "okay";
};

&gpio_prt2 {
	status = "okay";
};

&gpio_prt3 {
	status = "okay";
};

&gpio_prt10 {
	status = "okay";
};

&gpio_prt13 {
	status = "okay";
};

&gpio_prt14 {
	status = "okay";
};

&gpio_prt23 {
	status = "okay";
};

&gpio_prt29 {
	status = "okay";
};

&gpio_prt31 {
	status = "okay";
};

&gpio_prt32 {
	status = "okay";
};

&eco {
        status = "okay";
};

&pll0 {
        status = "okay";
};

&pll1 {
        status = "okay";
};

&pll2 {
        status = "okay";
};

&pll3 {
        status = "okay";
};

&clk_hf0 {
        status = "okay";
};

&clk_hf1 {
        status = "okay";
};

&clk_hf2 {
        status = "okay";
};

&clk_hf3 {
        status = "okay";
};

&clk_hf4 {
        status = "okay";
};

&clk_hf5 {
        status = "okay";
};

&clk_hf6 {
