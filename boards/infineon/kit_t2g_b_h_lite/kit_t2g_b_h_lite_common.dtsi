#include <arm/infineon/cat1c/traveo/cyt4bf/system_clocks.dtsi>
#include <arm/infineon/cat1c/traveo/cyt4bf/cyt4bf8cds.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	aliases {
		led0 = &user_led0;
		led1 = &user_led1;
		led2 = &user_led2;
		sw0 = &user_bt0;
		sw1 = &user_bt1;
	};

	leds {
		compatible = "gpio-leds";

		user_led0: led_0 {
			label = "LED_0";
			gpios = <&gpio_prt5 0 GPIO_ACTIVE_LOW>;
		};

		user_led1: led_1 {
			label = "LED_1";
			gpios = <&gpio_prt5 1 GPIO_ACTIVE_LOW>;
		};

		user_led2: led_2 {
			label = "LED_2";
			gpios = <&gpio_prt5 2 GPIO_ACTIVE_LOW>;
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led_0 {
			pwms = <&pwm3_9 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};

		pwm_led1: pwm_led_1 {
			pwms = <&pwm3_10 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};

		pwm_led2: pwm_led_2 {
			pwms = <&pwm3_11 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_bt0: user_btn0 {
			label = "SW_1";
			gpios = <&gpio_prt5 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};

		user_bt1: user_btn1 {
			label = "SW_2";
			gpios = <&gpio_prt17 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;

		sram_m0plus: memory@28000800 {
			compatible = "mmio-sram";
			reg = <0x28000800 DT_SIZE_K(30)>;
		};

		sram_m7_0: memory@28004000 {
			compatible = "mmio-sram";
			reg = <0x28004000  DT_SIZE_K(224)>;
		};

		sram_m7_1: memory@280d0000 {
			compatible = "mmio-sram";
			reg = <0x280d0000 DT_SIZE_K(256)>;
		};
	};
};

&code_flash0 {
        partitions {
                ranges;
                #address-cells = <1>;
                #size-cells = <1>;

                m0p_partition: partition_m0p@0 {
                        compatible = "zephyr,mapped-partition";
                        label = "m0p_partition";
                        reg = <0x0 DT_SIZE_K(512)>;
                };

                m7_0_partition: partition@80000 {
                        compatible = "zephyr,mapped-partition";
                        label = "m7_0_partition";
                        reg = <0x80000 DT_SIZE_K(2656)>;
                };

                m7_1_partition: partition@280000 {
                        compatible = "zephyr,mapped-partition";
                        label = "m7_1_partition";
                        reg = <0x280000 DT_SIZE_K(3168)>;
                };
        };
};

uart0: &scb0 {
	compatible = "infineon,uart";
	current-speed = <115200>;
	dmas = <&dma1 16>, <&dma1 17>;
	dma-names = "tx", "rx";
	clocks = <&clk_peri1 30 0 0>;

	/* UART pins */
	pinctrl-0 = <&p0_1_scb0_uart_tx &p0_0_scb0_uart_rx
		     &p0_2_scb0_uart_rts &p0_3_scb0_uart_cts>;
	pinctrl-names = "default";
};

uart2: &scb2 {
	compatible = "infineon,uart";
	current-speed = <115200>;
	dmas = <&dma1 20>, <&dma1 21>;
	dma-names = "tx", "rx";
	clocks = <&clk_peri1 32 0 1>;

	/* UART pins */
	pinctrl-0 = <&p14_1_scb2_uart_tx &p14_0_scb2_uart_rx>;
	pinctrl-names = "default";
};

spi1: &scb3 {
	#address-cells = <1>;
	#size-cells = <0>;
	compatible = "infineon,spi";
	clocks = <&clk_peri1 33 1 3>;

	/* SPI pins */
	pinctrl-0 = <&p13_0_scb3_spi_m_miso &p13_1_scb3_spi_m_mosi &p13_2_scb3_spi_m_clk>;
	pinctrl-names = "default";
	cs-gpios = <&gpio_prt13 5 GPIO_ACTIVE_LOW>;

	dmas = <&dma1 22>, <&dma1 23>;
	dma-names = "tx", "rx";
};

i2c2: &scb4 {
        compatible = "infineon,i2c";
        #address-cells = <1>;
        #size-cells = <0>;
        clocks = <&clk_peri1 34 0 2>;
        /* I2C pins */
        pinctrl-0 = <&p6_1_scb4_i2c_sda &p6_2_scb4_i2c_scl>;
        pinctrl-names = "default";
        status = "okay";
};

&adc0 {
        #address-cells = <1>;
        #size-cells = <0>;
        clocks = <&clk_peri1 42 0 3>;
        clock-frequency = <26670000>;
        status = "okay";

};

&dma1 {
	status = "okay";
};

&gpio_prt5 {
	status = "okay";
};

&gpio_prt6 {
	status = "okay";
};

&gpio_prt17 {
	status = "okay";
};

&eco {
        status = "okay";
};

&pll0 {
        status = "okay";
};

&pll1 {
        status = "okay";
};

&pll2 {
        status = "okay";
};

&pll3 {
        status = "okay";
};

&clk_hf0 {
        status = "okay";
};

&clk_hf1 {
        status = "okay";
};

&clk_hf2 {
        status = "okay";
};

&clk_hf3 {
        status = "okay";
};

&clk_hf4 {
        status = "okay";
};

&clk_hf5 {
        status = "okay";
};

&clk_hf6 {
        status = "okay";
};

&clk_hf7 {
        status = "okay";
};

&clk_peri1 {
        status = "okay";
};
