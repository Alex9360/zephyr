#include <arm/infineon/cat1c/traveo/cyt4dn/system_clocks.dtsi>
#include <arm/infineon/cat1c/traveo/cyt4dn/cyt4dn.dtsi>
#include <arm/infineon/cat1c/traveo/cyt4dn/cyt4dn-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pinctrl/ifx_cat1-pinctrl.h>

/ {
	leds {
		compatible = "gpio-leds";
		user_led1: user_led1 {
			label = "LED_1";
			gpios = <&gpio_prt7 5 GPIO_ACTIVE_HIGH>;
		};
		user_led2: user_led2 {
			label = "LED_2";
			gpios = <&gpio_prt7 6 GPIO_ACTIVE_HIGH>;
		};
		user_led3: user_led3 {
			label = "LED_3";
			gpios = <&gpio_prt7 7 GPIO_ACTIVE_HIGH>;
		};
	};
};

uart7: &scb7 {
	compatible = "infineon,uart";
	current-speed = <115200>;
	dmas = <&dma1 30>, <&dma1 31>;
	dma-names = "tx", "rx";
	clocks = <&clk_peri1 15 0 1>;

	/* UART pins */
	pinctrl-0 = <&p9_0_scb7_uart_rx &p9_1_scb7_uart_tx>;
	pinctrl-names = "default";
};

uart9: &scb9 {
	compatible = "infineon,uart";
	current-speed = <115200>;
	dmas = <&dma1 34>, <&dma1 35>;
	dma-names = "tx", "rx";
	clocks = <&clk_peri1 17 0 0>;

	/* UART pins */
	pinctrl-0 = <&p29_0_scb9_uart_rx &p29_1_scb9_uart_tx>;
	pinctrl-names = "default";
};

&dma1 {
	status = "okay";
};

i2c11: &scb11 {
	compatible = "infineon,i2c";
	clocks = <&clk_peri1 19 0 2>;

        #address-cells = <1>;
        #size-cells = <0>;

	/* UART pins */
	pinctrl-0 = <&p0_4_scb11_i2c_scl &p0_5_scb11_i2c_sda>;
	pinctrl-names = "default";
	status = "okay";
};

&adc0 {
	clock-frequency = <26670000>;
	clocks = <&clk_peri1 20 0 2>;
	status = "okay";
};

&gpio_prt7 {
	status = "okay";
};

&eco {
	status = "okay";
};

&pll0 {
	status = "okay";
};

&pll1 {
	status = "okay";
};

&pll2 {
	status = "okay";
};

&pll3 {
	status = "okay";
};

&pll4 {
	status = "okay";
};

&pll5 {
	status = "okay";
};

&pll6 {
	status = "okay";
};

&clk_hf0 {
	status = "okay";
};

&clk_hf1 {
	status = "okay";
};

&clk_hf2 {
	status = "okay";
};

&clk_hf3 {
	status = "okay";
};

&clk_hf4 {
	status = "okay";
};

&clk_hf5 {
	status = "okay";
};

&clk_hf6 {
	status = "okay";
};

&clk_hf7 {
	status = "okay";
};

&clk_hf8 {
	status = "okay";
};

&clk_hf9 {
	status = "okay";
};

&clk_hf10 {
	status = "okay";
};

&clk_hf11 {
	status = "okay";
};

&clk_hf12 {
	status = "okay";
};

&clk_peri1 {
	status = "okay";
};
