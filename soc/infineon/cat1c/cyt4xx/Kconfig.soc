# SOC series
config SOC_SERIES_CYT4XX
	bool
	select SOC_FAMILY_INFINEON_CAT1C
	select SOC_FAMILY_INFINEON_TRAVEO

config SOC_SERIES
	default "cyt4xx" if SOC_SERIES_CYT4XX

config SOC_DIE_CYT4DN
	bool

config SOC_DIE_CYT4BF
	bool

# cyt4dnjbzs
config SOC_CYT4DNJBZS
	bool
	select SOC_SERIES_CYT4XX
	select SOC_DIE_CYT4DN

# Infineon T2G Body High series MCUs: CYT4BFCCHE
config SOC_CYT4BFCCHE
	bool
	select SOC_SERIES_CYT4XX
	select SOC_DIE_CYT4BF

config SOC
	default "cyt4dnjbzs" if SOC_CYT4DNJBZS
	default "cyt4bfcche" if SOC_CYT4BFCCHE
