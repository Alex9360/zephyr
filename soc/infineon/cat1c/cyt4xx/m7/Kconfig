if SOC_SERIES_CYT4XX

config SOC_CYT4XX_M7
	bool
	default y if SOC_CYT4XX_CORE_M7_0 || SOC_CYT4XX_CORE_M7_1
	select ARM
	select CPU_CORTEX_M7
	select CPU_CORTEX_M_HAS_SYSTICK
	select CPU_CORTEX_M_HAS_VTOR
	select CPU_HAS_ARM_MPU
	select CPU_HAS_ICACHE
	select CPU_HAS_DCACHE
	select CPU_HAS_FPU
	select SOC_PREP_HOOK
	select SOC_EARLY_INIT_HOOK

config SOC_CYT4XX_CORE_M7_0
	bool
	default y if SOC_CYT4DNJBZS_M7_0 || SOC_CYT4BFCCHE_M7_0

config SOC_CYT4XX_CORE_M7_1
	bool
	default y if SOC_CYT4DNJBZS_M7_1 || SOC_CYT4BFCCHE_M7_1

endif
