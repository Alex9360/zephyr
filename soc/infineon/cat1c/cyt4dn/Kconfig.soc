# SOC series
config SOC_SERIES_CYT4DN
	bool
	select SOC_FAMILY_INFINEON_CAT1C

config SOC_SERIES
	default "cyt4dn" if SOC_SERIES_CYT4DN

config SOC_CYT4DNJBZS
	bool
	select SOC_SERIES_CYT4DN

config SOC_CYT4DNJBZS_M0PLUS
	bool
	select SOC_CYT4DNJBZS

config SOC_CYT4DNJBZS_M7
	bool
	select SOC_CYT4DNJBZS

config SOC
	default "cyt4dnjbzs" if SOC_CYT4DNJBZS
